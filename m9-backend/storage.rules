rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /artifacts/{appId}/private/m5/reviewer_proofs/{uid}/{subjectCode}/{fileName} {
      // Main admin: custom claim hoặc đúng tài khoản quản trị cũ; không tin prefix email.
      allow read: if request.auth != null && (request.auth.uid == uid
        || request.auth.token.get('admin', false) == true
        || request.auth.token.get('role', '') == 'main_admin'
        || request.auth.token.get('email', '') == 'khaianhxuanai@khaidayyhub.com');
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow update, delete: if false;
    }
  }
}
